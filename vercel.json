{
  "version": 2,
  "installCommand": "npm ci && npm --prefix frontend/klask-4 ci",
  "buildCommand": "npm --prefix frontend/klask-4 run build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/klask-4",
      "dest": "/frontend/klask-4/dist/index.html"
    },
    {
      "src": "/klask-4/(.*)",
      "dest": "/frontend/klask-4/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
