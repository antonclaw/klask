{
  "version": 2,
  "installCommand": "npm ci && npm --prefix frontend/klask ci",
  "buildCommand": "npm --prefix frontend/klask run build",
  "outputDirectory": "frontend/klask/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/klask-4",
      "destination": "/klask-4.html"
    },
    {
      "source": "/klask-4/",
      "destination": "/klask-4.html"
    },
    {
      "source": "/klask-4-solo",
      "destination": "/klask-4-solo.html"
    },
    {
      "source": "/klask-4-solo/",
      "destination": "/klask-4-solo.html"
    }
  ]
}
