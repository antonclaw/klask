{
  "version": 2,
  "installCommand": "npm ci && npm --prefix frontend/klask ci",
  "buildCommand": "npm --prefix frontend/klask run build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/frontend/klask/dist/index.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/klask/dist/assets/$1"
    },
    {
      "src": "/klask-4",
      "dest": "/frontend/klask/dist/klask-4.html"
    },
    {
      "src": "/klask-4/",
      "dest": "/frontend/klask/dist/klask-4.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
